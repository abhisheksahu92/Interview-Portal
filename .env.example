# Copy to .env and adjust. Never commit .env.
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite (default) or postgres://user:pass@db:5432/interview_portal
DATABASE_URL=sqlite:///db_v2.sqlite3

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=no-reply@interview-portal.local
# Only used with django.core.mail.backends.filebased.EmailBackend
EMAIL_FILE_PATH=
# On-disk root for uploads (resumes) when no S3/R2 bucket is configured
MEDIA_ROOT=

# Optional: enables AI features in assessments
ANTHROPIC_API_KEY=

# Optional: enables Stripe billing (per-active-job plans). Blank = billing UI
# shows the plan/usage but upgrade/portal are disabled.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# Used by docker-compose postgres service
POSTGRES_DB=interview_portal
POSTGRES_USER=interview
POSTGRES_PASSWORD=interview

# Deployment / proxy (only relevant when DEBUG=False)
# Must include the scheme; comma-separated.
CSRF_TRUSTED_ORIGINS=https://interview-portal.fly.dev
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
# Seconds to reuse DB connections (0 = new connection per request; keep 0 for tests)
CONN_MAX_AGE=60

# Optional: object storage for resumes (S3 or Cloudflare R2). Media stays on the
# local filesystem unless AWS_STORAGE_BUCKET_NAME is set.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=auto
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Phase 3 features -----------------------------------------------------
# Absolute base URL used in emails, .ics invites, careers pages, share links.
SITE_URL=http://127.0.0.1:8000

# billing: Razorpay (INR subscriptions/orders + webhooks). Blank = Razorpay
# checkout disabled; Stripe/manual plans still work.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# billing: GST details printed on invoices (state code drives CGST/SGST vs IGST)
COMPANY_GSTIN=
COMPANY_STATE_CODE=

# notifications: WhatsApp Business Cloud API. Blank = WhatsApp channel is
# skipped and only email notifications are sent.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# scheduling: calendar OAuth. Blank = no calendar sync; manual scheduling only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=

# clients: client portal needs no keys (tokenised links only).
# talent: bulk resume import reuses ANTHROPIC_API_KEY for AI extraction.
# video: uploads use the AWS_*/MEDIA_ROOT storage configured above.
# careers: public careers site + Indeed XML feed; uses SITE_URL.
# analytics: no keys (Chart.js via CDN).
# offers: click-to-sign is built in; external e-sign adapter needs no keys yet.
# partners: white-label/reseller dashboards need no keys.
# marketplace: paid question packs are billed through the Razorpay keys above.

# video: transcription adapter for recorded answers. Blank = responses are
# stored and playable but transcript/ai_summary stay empty.
# VIDEO_TRANSCRIBE_API_KEY=
# VIDEO_TRANSCRIBE_URL=

# offers: optional external e-sign provider. Blank = built-in click-to-sign.
# ESIGN_API_BASE=
# ESIGN_ACCOUNT_ID=
# ESIGN_API_KEY=

# careers: job-board distribution adapters. Blank = the board shows a
# "connect account" prompt instead of posting. The Indeed XML feed needs no key.
# LINKEDIN_JOBS_TOKEN=
# NAUKRI_API_KEY=

# notifications: WhatsApp Business Cloud webhook verification handshake token.
# WHATSAPP_VERIFY_TOKEN=

# partners: Ed25519 private key used ONLY by `manage.py issue_license` to sign
# self-hosted licence keys — base64 of the raw 32 bytes. Vendor-only: leave it
# blank on customer installs, which verify keys with the public key embedded in
# partners/licensing.py. Generate one with `manage.py generate_license_keypair`
# and keep it in a secrets manager; never commit it.
# LICENSE_SIGNING_KEY=

# integrations: optional override for the Fernet key that encrypts connector
# credentials (ConnectorConfig.settings) at rest — urlsafe-base64 of 32 bytes.
# Blank derives the key from SECRET_KEY with HKDF-SHA256, which is fine for a
# single install; set it explicitly if you need to rotate SECRET_KEY without
# losing stored HRMS/background-check API keys. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# INTEGRATIONS_ENCRYPTION_KEY=
