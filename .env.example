# Copy to .env and adjust. Never commit .env.
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite (default) or postgres://user:pass@db:5432/interview_portal
DATABASE_URL=sqlite:///db_v2.sqlite3

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=no-reply@interview-portal.local

# Optional: enables AI features in assessments
ANTHROPIC_API_KEY=

# Used by docker-compose postgres service
POSTGRES_DB=interview_portal
POSTGRES_USER=interview
POSTGRES_PASSWORD=interview
