# ---------------------------------------------------------------------------
# LOCAL — your laptop. SQLite, console email, no real money, no real AI spend.
# Copy to the repo root as `.env`:   cp envs/.env.local.example .env
# ---------------------------------------------------------------------------
DEBUG=True
SECRET_KEY=local-insecure-key-do-not-use-anywhere-else
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SITE_URL=http://localhost:8000
SECURE_SSL_REDIRECT=False

# SQLite file, no server to run.
DATABASE_URL=sqlite:///db_v2.sqlite3

# Emails print to the terminal instead of being sent.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=dev@localhost

# Uploads stay on the local filesystem while the bucket name is empty.
AWS_STORAGE_BUCKET_NAME=

# Leave blank to keep AI screening in manual-fallback mode and spend nothing.
ANTHROPIC_API_KEY=

# Razorpay TEST keys. Billing flows work end to end, no real charge.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Invoice issuer identity (your own company). 27 = Maharashtra.
COMPANY_GSTIN=
COMPANY_STATE_CODE=27

# Fernet key for stored HRMS credentials. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATIONS_ENCRYPTION_KEY=
LICENSE_SIGNING_KEY=

DJANGO_LOG_LEVEL=INFO
