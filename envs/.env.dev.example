# ---------------------------------------------------------------------------
# DEV / STAGING — deployed, but disposable. Neon dev branch, test money.
# Safe to wipe and reseed. Never point this at the production database.
# ---------------------------------------------------------------------------
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=dev.interview.abhishreelabs.in
CSRF_TRUSTED_ORIGINS=https://dev.interview.abhishreelabs.in
SITE_URL=https://dev.interview.abhishreelabs.in
SECURE_SSL_REDIRECT=True
# Short HSTS on staging so a certificate mistake is not sticky in browsers.
SECURE_HSTS_SECONDS=300

# Neon DEV BRANCH pooled connection string, not the main branch.
DATABASE_URL=

# Separate R2 bucket so staging uploads never mix with real candidate files.
AWS_STORAGE_BUCKET_NAME=interview-portal-media-dev
AWS_S3_REGION_NAME=auto
AWS_S3_ENDPOINT_URL=https://<cloudflare-account-id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Real SMTP, but send only to your own addresses while testing.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

ANTHROPIC_API_KEY=

# Razorpay TEST keys here too. Live keys belong only in prod.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

COMPANY_GSTIN=
COMPANY_STATE_CODE=27

# Must differ from production. Sharing this key would let one environment
# decrypt the other's stored HRMS credentials.
INTEGRATIONS_ENCRYPTION_KEY=
LICENSE_SIGNING_KEY=

# Mock background-verification provider: no vendor charges on staging.
BGV_PROVIDER=mock

DJANGO_LOG_LEVEL=INFO
