# ---------------------------------------------------------------------------
# PRODUCTION — real customers, real money, real candidate data.
# These values live ONLY in the Render dashboard. This file is a checklist of
# what must be set; it must never hold an actual secret.
# ---------------------------------------------------------------------------
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=interview.abhishreelabs.in
CSRF_TRUSTED_ORIGINS=https://interview.abhishreelabs.in
SITE_URL=https://interview.abhishreelabs.in
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Neon MAIN branch, POOLED connection string. The unpooled one exhausts
# connections once more than a couple of workers are running.
DATABASE_URL=

AWS_STORAGE_BUCKET_NAME=interview-portal-media
AWS_S3_REGION_NAME=auto
AWS_S3_ENDPOINT_URL=https://<cloudflare-account-id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Required. Without it every AI screening silently falls back to manual.
ANTHROPIC_API_KEY=

# Razorpay LIVE keys, available only after KYC is approved.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Your GSTIN appears on every invoice the platform issues. Wrong value means
# wrong tax documents for customers.
COMPANY_GSTIN=
COMPANY_STATE_CODE=

# Losing this key makes every stored HRMS credential unreadable. Back it up
# outside Render.
INTEGRATIONS_ENCRYPTION_KEY=
LICENSE_SIGNING_KEY=

# Switch to your real vendor once contracted; `mock` never verifies anything.
BGV_PROVIDER=mock
BGV_API_BASE=
BGV_API_KEY=

# Optional channels, safe to leave blank at launch.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=

DJANGO_LOG_LEVEL=WARNING
